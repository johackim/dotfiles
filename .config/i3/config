set $mod Mod4

font pango:Inconsolata Nerd Font 14
floating_modifier $mod

bindsym $mod+Return exec urxvtc

bindsym $mod+Shift+q kill

bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+m focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+m move right

bindsym $mod+Shift+Left move left 50
bindsym $mod+Shift+Down move down 50
bindsym $mod+Shift+Up move up 50
bindsym $mod+Shift+question move up 50
bindsym $mod+Shift+Right move right 50

bindsym $mod+h split h
bindsym $mod+v split v

bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+x layout toggle stacking tabbed split

bindsym $mod+Shift+space floating toggle

bindsym $mod+space focus mode_toggle

bindsym $mod+a focus parent

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id "i3-nagbar -t warning -m 'Do you really want to exit i3?' -b 'Yes, exit i3' 'i3-msg exit'"

mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym m resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 50 px or 50 ppt
        bindsym Down resize grow height 50 px or 50 ppt
        bindsym Up resize shrink height 50 px or 50 ppt
        bindsym Right resize grow width 50 px or 50 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

bindsym $mod+b bar mode toggle

set_from_resource $bg i3wm.background #000000
set_from_resource $fg i3wm.foreground #FFFFFF
set_from_resource $c1 i3wm.color1 #046F6E
set_from_resource $c8 i3wm.color8 #00AAAA

bindsym $mod+d exec --no-startup-id zsh -ic 'eval "$(print -rl -- ${(k)aliases} ${(k)commands} ${(k)functions} | sort -u | dmenu -nf "$fg" -nb "$bg" -sb "$c1" -sf "$fg")"'

# class                 border  bground text indicator child_border
client.focused          $bg     $bg     $fg  $bg       $bg
client.focused_inactive $bg     $bg     $fg  $bg       $bg
client.unfocused        $bg     $bg     $c8  $bg       $bg
client.urgent           $bg     $bg     $fg  $bg       $bg
client.placeholder      $bg     $bg     $fg  $bg       $bg

bar {
    position bottom
    font pango:Noto Sans 9
    tray_padding 6
    status_command ~/.local/bin/status.sh
    colors {
        background #000000
        statusline $fg
        focused_workspace  $c1      $c1      $fg
        active_workspace   $c1      $c1      $fg
        inactive_workspace #000000 #000000 $fg
        urgent_workspace   #000000 #000000 $fg
    }
}

exec --no-startup-id urxvtd -o -f -q
exec --no-startup-id xset s off -dpms
exec --no-startup-id nm-applet
exec --no-startup-id dunst
exec --no-startup-id sh ~/.fehbg
exec --no-startup-id keynav daemonize
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id blueman-applet

exec --no-startup-id i3-msg 'workspace 1; exec urxvt -e ~/.local/bin/tmux-main.sh'
exec --no-startup-id i3-msg 'workspace 2; exec urxvt -e tmux new -As second -n editor'
exec --no-startup-id i3-msg 'workspace 3; exec --no-startup-id chromium'

assign [class="firefox" instance="Navigator"] 3
assign [class="Chromium" title="grafana.ethibox.fr"] 4
assign [class="Chromium|Google-chrome"] 3
assign [class="obsidian"] 6
assign [class="calibre"] 4
assign [class="Vlc|mpv"] 5
assign [class="qBittorrent"] 8
assign [class="TelegramDesktop"] 8
assign [class="signal"] 7
assign [class="discord"] 8

for_window [instance="gnome-calculator"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [class="Thunar" instance="file_progress"] floating enable
for_window [class="firefox" instance="places"] floating enable
for_window [class="Google-chrome"] floating disable
for_window [class="Chromium"] floating disable
for_window [class="Display"] floating enable
for_window [class="feh"] floating enable
for_window [class="Arandr"] floating enable
for_window [class="Wine"] floating enable
for_window [class="evince"] floating disable
for_window [class="^Vlc|mpv$"] focus
for_window [class="Foliate$"] floating disable
for_window [class="Spotify"] move to workspace 5
for_window [class="obsidian"] floating disable

hide_edge_borders both

bindsym Control+mod1+l exec --no-startup-id "i3lock -e -u -i ~/.cache/wal/lock.png"
bindsym 0xff61 exec --no-startup-id scrot ~/Downloads/screenshot_%Y_%m_%d_%H_%M_%S.png
bindsym $mod+Shift+t exec --no-startup-id "thunar"

bindsym $mod+Control+Down  exec --no-startup-id "playerctl --player=ncspot,spotify,chromium play-pause"
bindsym $mod+Control+Right exec --no-startup-id "playerctl --player=ncspot,spotify,chromium next"
bindsym $mod+Control+Left  exec --no-startup-id "playerctl --player=ncspot,spotify,chromium previous"

bindsym XF86AudioRaiseVolume exec --no-startup-id "pactl set-sink-volume 0 +5%"
bindsym XF86AudioLowerVolume exec --no-startup-id "pactl set-sink-volume 0 -5%"
bindsym XF86AudioMute exec --no-startup-id "pactl set-sink-mute 0 toggle"
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl s +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl s 10%-

bindsym Control+Shift+Down move scratchpad
bindsym Control+Shift+Up scratchpad show
bindsym Control+Shift+question scratchpad show

workspace_layout default
default_orientation horizontal
focus_follows_mouse no

bindsym $mod+Shift+s sticky toggle

bindsym $mod+y exec --no-startup-id $HOME/.local/bin/yt-copy.sh

include ~/.config/i3/custom.conf
