[global]
frame_color = "#cdffff"
idle_threshold = 120
max_icon_size = 32
enable_recursive_icon_lookup = true
browser = /usr/bin/chromium
icon_theme = "Pywal"

[urgency_low]
background = "#011313"
foreground = "#cdffff"

[urgency_normal]
background = "#011313"
foreground = "#cdffff"

[urgency_critical]
background = "#011313"
foreground = "#cdffff"
frame_color = "#cdffff"
