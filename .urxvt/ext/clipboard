#! perl

# Goes through xclip so that urxvt never owns the clipboard: pasting with
# `xclip -o` while urxvt owns it would deadlock the terminal.

sub on_action {
   my ($self, $action) = @_;

   if ($action eq 'copy') {
      open my $clipboard, '|-', qw(xclip -selection clipboard);
      print $clipboard $self->locale_encode($self->selection);
      close $clipboard;
   } elsif ($action eq 'paste') {
      $self->tt_paste(scalar qx(xclip -o -selection clipboard));
   }

   ()
}
