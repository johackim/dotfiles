! xrdb -merge ~/.Xresources (TO APPLY CHANGES)

URxvt.scrollBar: false

URxvt*font: xft:Inconsolata Nerd Font Mono:size=10,xft:Adwaita Mono:size=10
URxvt*letterSpace: 1

URxvt.cursorBlink: true

URxvt*.transparent: true
URxvt*.shading: 15

URxvt.iso14755: false
URxvt.iso14755_52: false

URxvt.perl-ext-common: default,matcher,font-size,notify

URxvt.keysym.C-Right: \033[1;5C
URxvt.keysym.C-Left: \033[1;5D
URxvt.keysym.C-C: clipboard:copy
URxvt.keysym.C-V: clipboard:paste

URxvt.url-launcher: chromium
URxvt.keysym.C-f: matcher:list
URxvt.keysym.C-0xff0d: matcher:list

URxvt.keysym.C-Up:     font-size:increase
URxvt.keysym.C-Down:   font-size:decrease

URxvt.urgentOnBell: true

! xrdb -query | grep dpi
Xft.dpi: 128

URxvt.geometry: 400x400
